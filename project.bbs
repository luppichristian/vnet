id(vnet)
name("Virtual Network")
ver(0.1.0)

targets(
  console(
    id(connect)
    output(connect)
    stdver(c17)
    include_dirs(src/lib src/protocol src/socket_api src/tables src/targets)
    units(src/targets/link.c src/lib/*.c src/protocol/*.c src/protocol/dns.c src/protocol/dhcp.c src/protocol/rip.c src/protocol/bgp.c src/protocol/ospf.c src/socket_api/socket.c src/socket_api/socket_tcp.c src/socket_api/socket_udp.c src/tables/*.c)
  )

  console(
    id(host)
    output(host)
    stdver(c17)
    include_dirs(src/lib src/protocol src/socket_api src/tables src/targets)
    units(src/targets/host.c src/lib/*.c src/protocol/*.c src/protocol/dns.c src/protocol/dhcp.c src/protocol/rip.c src/protocol/bgp.c src/protocol/ospf.c src/socket_api/socket.c src/socket_api/socket_tcp.c src/socket_api/socket_udp.c src/tables/*.c)
  )

  console(
    id(hub)
    output(hub)
    stdver(c17)
    include_dirs(src/lib src/protocol src/socket_api src/tables src/targets)
    units(src/targets/hub.c src/lib/*.c src/protocol/*.c src/protocol/dns.c src/protocol/dhcp.c src/protocol/rip.c src/protocol/bgp.c src/protocol/ospf.c src/socket_api/socket.c src/socket_api/socket_tcp.c src/socket_api/socket_udp.c src/tables/*.c)
  )

  console(
    id(switch)
    output(switch)
    stdver(c17)
    include_dirs(src/lib src/protocol src/socket_api src/tables src/targets)
    units(src/targets/switch.c src/lib/*.c src/protocol/*.c src/protocol/dns.c src/protocol/dhcp.c src/protocol/rip.c src/protocol/bgp.c src/protocol/ospf.c src/socket_api/socket.c src/socket_api/socket_tcp.c src/socket_api/socket_udp.c src/tables/*.c)
  )

  console(
    id(router)
    output(router)
    stdver(c17)
    include_dirs(src/lib src/protocol src/socket_api src/tables src/targets)
    units(src/targets/router.c src/lib/*.c src/protocol/*.c src/protocol/dns.c src/protocol/dhcp.c src/protocol/rip.c src/protocol/bgp.c src/protocol/ospf.c src/socket_api/socket.c src/socket_api/socket_tcp.c src/socket_api/socket_udp.c src/tables/*.c)
  )

  console(
    id(dhcp_server)
    output(dhcp_server)
    stdver(c17)
    include_dirs(src/lib src/protocol src/socket_api src/tables src/targets)
    units(src/targets/dhcp_server.c src/lib/*.c src/protocol/*.c src/protocol/dns.c src/protocol/dhcp.c src/protocol/rip.c src/protocol/bgp.c src/protocol/ospf.c src/socket_api/socket.c src/socket_api/socket_tcp.c src/socket_api/socket_udp.c src/tables/*.c)
  )

  console(
    id(dns_server)
    output(dns_server)
    stdver(c17)
    include_dirs(src/lib src/protocol src/socket_api src/tables src/targets)
    units(src/targets/dns_server.c src/lib/*.c src/protocol/*.c src/protocol/dns.c src/protocol/dhcp.c src/protocol/rip.c src/protocol/bgp.c src/protocol/ospf.c src/socket_api/socket.c src/socket_api/socket_tcp.c src/socket_api/socket_udp.c src/tables/*.c)
  )

  console(
    id(watch)
    output(watch)
    stdver(c17)
    include_dirs(src/lib src/protocol src/socket_api src/tables src/targets)
    units(src/targets/watch.c src/lib/*.c src/protocol/*.c src/protocol/dns.c src/protocol/dhcp.c src/protocol/rip.c src/protocol/bgp.c src/protocol/ospf.c src/socket_api/socket.c src/socket_api/socket_tcp.c src/socket_api/socket_udp.c src/tables/*.c)
  )
